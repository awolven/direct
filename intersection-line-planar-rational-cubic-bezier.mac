#|
cd ~/maxima/src/binary-sbcl

/usr/local/bin/sbcl --core maxima.core --dynamic-space-size 512000

(cl-user::run)

PA:[[xa0,ya0],[xa1,ya1]];
Bin(var,n):=binomial(n,i)*(var^i)*(1-var)^(n-i);
CA:sum(PA[i+1]*Bin(t,1),i,0,1);
PB:[[xb0,yb0],[xb1,yb1],[xb2,yb2],[xb3,yb3]];
WB:[wb0,wb1,wb2,wb3];
CB:sum(WB[i+1]*PB[i+1]*Bin(s,3),i,0,3)/sum(WB[i+1]*Bin(s,3),i,0,3);
XA:CA[1];
YA:CA[2];
XB:CB[1];
YB:CB[2];

IMPLIC:resultant(XA-x,YA-y,t);
INTER0:subst([x=XB,y=YB],''IMPLIC);
INTER1:ratsimp(INTER0,s)$
INTER2:denom(INTER1)*INTER1$
INTER3:collectterms(INTER2,[s])$

coeffs(polynomial, vars, degrees) :=
 block([coef:polynomial],
       for i from 1 thru length(degrees)
        do block([degree:degrees[i]],
	         coef:ratcoef(coef, vars[i], degree)),
coef);

ratsimp(coeffs(INTER3,[s],[0]));

to_lisp();
(defun clify-maxima-expression (expression)
  (when expression
    (cond ((listp expression)
	   (cond ((typep (car expression) 'cons)
		  (cond ((eq (caar expression) 'maxima::mplus)
			 (cons '+ (mapcar #'clify-maxima-expression (cdr expression))))
			((eq (caar expression) 'maxima::mtimes)
			 (cons '* (mapcar #'clify-maxima-expression (cdr expression))))
			((eq (caar expression) 'maxima::mexpt)
			 (cons 'expt (mapcar #'clify-maxima-expression (cdr expression))))
			(t (cons (car expression) (mapcar #'clify-maxima-expression (cdr expression))))))
		 (t (error "A"))))
	  ((typep expression 'number) expression)
	  ((typep expression 'symbol)
	   (cond ((char= #\$ (char (symbol-name expression) 0))
		  (intern (subseq (symbol-name expression) 1)))
		 (t expression)))
(t (error "B")))))

(setq *print-level* nil *print-length* nil)

(pprint (cse (clify-maxima-expression $%)))
(to-maxima)

