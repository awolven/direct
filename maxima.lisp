(in-package :direct)


(defmethod maxima-parametric-equations ((self 2d-line))
  `maxima::((mlist)
	    ((mequal)
	     $x
	     ((mplus) ,direct::(rationalize (vx (the start)))
	      ((mtimes) $s
	       ((mminus)
		,direct::(rationalize (vx (the end)))
		,direct::(rationalize (vx (the start)))))))
	    ((mequal)
	     $y
	     ((mplus) ,direct::(rationalize (vy (the start)))
	      ((mtimes) $s
	       ((mminus)
		,direct::(rationalize (vy (the end)))
		,direct::(rationalize (vy (the start)))))))))

(defmethod maxima-implicit-equation ((self ellipse))
  `maxima::((mequal)
	    1
	    ((mplus)
	     ((mtimes)
	      ((mexpt)
	       ((mminus)
		$x ,direct::(rationalize (vx (the center))))
	       2)
	      ,direct::(/ 1 direct::(expt (rationalize (the semi-major-axis)) 2)))
	     ((mtimes)
	      ((mexpt)
	       ((mminus)
		$y ,direct::(rationalize (vy (the center))))
	       2)
	      ,direct::(/ 1 direct::(expt (rationalize (the semi-minor-axis)) 2))))))

(defmethod maxima-parametric-equations ((self bezier-plane-curve))
  (let ((cpoints (the control-points)))
    (cond ((= (the degree) 3)
	   `maxima::((mlist simp)
		     ((mplus simp) ,direct::(rationalize (vx (aref cpoints 0)))
		      ((mtimes simp) ,direct::(* -3 (rationalize (vx (aref cpoints 0)))) $t)
		      ((mtimes simp) ,direct::(* 3 (rationalize (vx (aref cpoints 1)))) $t)
		      ((mtimes simp) ,direct::(* 3 (rationalize (vx (aref cpoints 0)))) ((mexpt simp) $t 2))
		      ((mtimes simp) ,direct::(* -6 (rationalize (vx (aref cpoints 1)))) ((mexpt simp) $t 2))
		      ((mtimes simp) ,direct::(* 3 (rationalize (vx (aref cpoints 2)))) ((mexpt simp) $t 2))
		      ((mtimes simp) ,direct::(* -1 (rationalize (vx (aref cpoints 0)))) ((mexpt simp) $t 3))
		      ((mtimes simp) ,direct::(* 3 (rationalize (vx (aref cpoints 1)))) ((mexpt simp) $t 3))
		      ((mtimes simp) ,direct::(* -3 (rationalize (vx (aref cpoints 2)))) ((mexpt simp) $t 3))
		      ((mtimes simp) ,direct::(rationalize (vx (aref cpoints 3))) ((mexpt simp) $t 3)))
		     ((mplus simp) ,direct::(rationalize (vy (aref cpoints 0)))
		      ((mtimes simp) ,direct::(* -3 (rationalize (vy (aref cpoints 0)))) $t)
		      ((mtimes simp) ,direct::(* 3 (rationalize (vy (aref cpoints 1)))) $t)
		      ((mtimes simp) ,direct::(* 3 (rationalize (vy (aref cpoints 0)))) ((mexpt simp) $t 2))
		      ((mtimes simp) ,direct::(* -6 (rationalize (vy (aref cpoints 1)))) ((mexpt simp) $t 2))
		      ((mtimes simp) ,direct::(* 3 (rationalize (vy (aref cpoints 2)))) ((mexpt simp) $t 2))
		      ((mtimes simp) ,direct::(* -1 (rationalize (vy (aref cpoints 0)))) ((mexpt simp) $t 3))
		      ((mtimes simp) ,direct::(* 3 (rationalize (vy (aref cpoints 1)))) ((mexpt simp) $t 3))
		      ((mtimes simp) ,direct::(* -3 (rationalize (vy (aref cpoints 2)))) ((mexpt simp) $t 3))
		      ((mtimes simp) ,direct::(rationalize (vy (aref cpoints 3))) ((mexpt simp) $t 3))))))))
